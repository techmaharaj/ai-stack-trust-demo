# Copy to .env and fill in what's blank. Everything this repo needs from
# you lives in this one file.

# ── LLM provider ─────────────────────────────────────────────────────
# A PINNED free model, not OpenRouter's `openrouter/free` auto-router.
# Found 2026-09-17: the auto-router picks a different underlying model
# every single call -- most are fine, but some don't stop after a denial
# and instead burn minutes retrying with test/empty payloads to "probe"
# why. Pinning gives consistent, dry-run-able behavior. Re-verify with a
# few dry runs if you change this -- reliability genuinely varies by
# model. List current free tool-calling models:
# curl -s https://openrouter.ai/api/v1/models | python3 -c "
# import json,sys
# for m in json.load(sys.stdin)['data']:
#     if m['id'].endswith(':free') and 'tools' in (m.get('supported_parameters') or []):
#         print(m['id'])"
LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_API_KEY=

# ── Cluster targeting ───────────────────────────────────────────────
# kubectl context to use. Leave blank to use your current context.
KUBE_CONTEXT=

# Prefix for every namespace/resource this repo creates and later deletes
# on teardown.
NAMESPACE_PREFIX=ai-trust-demo

# ── Observability ───────────────────────────────────────────────────
JAEGER_LOCAL_PORT=16686
OTEL_COLLECTOR_ENDPOINT=http://jaeger-collector.${NAMESPACE_PREFIX}-observability.svc.cluster.local:4317

# Optional. Auto-detected from the in-cluster docker-registry Service +
# node IP if blank. Set this explicitly if that auto-detected address
# isn't in Docker's insecure-registries (check /etc/docker/daemon.json --
# an HTTP-only registry needs to be listed there, or docker push fails
# with an HTTPS handshake error).
LOCAL_REGISTRY=

# ── Retrieval (Gate 2) ──────────────────────────────────────────────
# Milvus Lite is file-backed, no server to configure.
MILVUS_DB_PATH=./retrieval/runbooks.db

# ── Governance (Gate 4) ─────────────────────────────────────────────
# Annotation key + value the Kyverno policy requires on any mutating
# action against a resource labeled env=prod. The agent is never told to
# add this -- that's the point of the deny.
APPROVAL_ANNOTATION_KEY=demo.io/approved-by
